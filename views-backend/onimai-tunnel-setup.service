[Unit]
Description=Authorize and finalize the Onimai views tunnel
Wants=network-online.target
After=network-online.target onimai-views.service
OnSuccess=onimai-tunnel.service

[Service]
Type=oneshot
User=onimai-tunnel
Group=onimai-ingress
WorkingDirectory=/var/lib/onimai-tunnel
ExecStart=/opt/onimai-views/.venv/bin/python /opt/onimai-views/setup_tunnel.py
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/onimai-tunnel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
